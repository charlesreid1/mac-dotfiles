# don't clobber
# -----------------
# Interactive-human only. Claude Code sets CLAUDECODE=1 in its shells, and
# -i prompts on a non-tty silently no-op there.
if [ -z "$CLAUDECODE" ]; then
    alias rm='rm -i'
    alias cp='cp -i'
    alias mv='mv -i'
fi





# ls aliases
# --------------------
# Detect which `ls` flavor is in use
# https://gist.github.com/skyzyx/3438280b18e4f7c490db8a2a2ca0b9da

#if ls --version >/dev/null 2>&1; then
#    # GNU ls
#else
#    # BSD ls
#fi


# the --color flag works with either verison of ls
alias ls='command ls -lh --color'
alias sl='ls'

# List all files colorized in long format
alias l="ls -lhAF --color"
alias ll="l"

# List all files colorized in long format, including dot files
alias la="l -a"

# List only directories
alias lsd="ls -lF --color | grep --color=never '^d'"


alias lr='ls -r' # reverse
alias llr='ll -r' # reverse

alias lt='ls -t' # time
alias llt='ll -t' # time

alias ltr='ls -tr' # reverse time
alias lltr='ll -tr' # reverse time

alias lk='ls -lSr' # by size (small to big)




